ENV=production
APP_NAME=LimeSurvey RemoteControl 2 Adapter

# Configure one or both trusted callers. The dictionary-only deployment needs
# DICTIONARY_SERVICE_JWT_SECRET; Form Builder additionally configures its own.
FORM_BUILDER_SERVICE_JWT_SECRET=
DICTIONARY_SERVICE_JWT_SECRET=replace-with-a-random-64-hex-character-value
FORM_BUILDER_SERVICE_JWT_ISSUER=form-builder-server
DICTIONARY_SERVICE_JWT_ISSUER=limesurvey-dictionary-api
JWT_AUDIENCE=limesurvey-rc2-api

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-another-random-64-hex-character-value
REDIS_DB=0
REDIS_SSL=false
REDIS_USERNAME=
# When REDIS_SSL=true, optionally trust the organization's CA certificate.
REDIS_SSL_CA_CERTS=
ALLOW_IN_MEMORY_STATE=false

ALLOWED_LIMESURVEY_HOSTS=ls.example.org
ALLOW_INSECURE_LIMESURVEY_HTTP=false

# Remote HTTP and endpoint limits. Connect covers opening the socket; read
# covers waiting for a LimeSurvey response after the connection exists.
LS_REMOTE_CONNECT_TIMEOUT_SECONDS=5
LS_REMOTE_READ_TIMEOUT_SECONDS=30
LS_LOGIN_TIMEOUT_SECONDS=10
LS_SURVEYS_TIMEOUT_SECONDS=10
LS_SURVEY_LOAD_TIMEOUT_SECONDS=120
LS_RESPONSES_TIMEOUT_SECONDS=60

# Optional bounded benchmark. Disabled keeps the conservative defaults below.
LS_OPTIMIZER_ENABLED=false
LS_OPTIMIZER_TTL_SECONDS=259200
LS_OPTIMIZER_MIN_SUCCESS_RATE=0.95
LS_OPTIMIZER_MAX_SURVEYS=3
LS_OPTIMIZER_MAX_GROUPS=10
LS_OPTIMIZER_MAX_SAMPLE_QUESTIONS=10
LS_SESSION_TTL_SECONDS=1800
